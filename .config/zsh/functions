# pick up SSH_AUTH_SOCK/DISPLAY from tmux after reattach
_zsh_tmux_refresh_env() {
  (( $+commands[tmux] )) || return 0
  [[ -z $TMUX ]] && return 0
  local line
  for line in ${(f)"$(tmux show-env 2> /dev/null)"}; do
    case $line in
      SSH_AUTH_SOCK=?*|DISPLAY=?*) export "$line" ;;
    esac
  done
}
autoload -Uz add-zsh-hook
add-zsh-hook preexec _zsh_tmux_refresh_env

# colorized printer logs
plog() {
  if [ "$#" -eq 1 ]; then
    ssh $1 tail -f /tmp/printer.log
  else
    ssh $2 "find /tmp/ -type d -regex '.*/SESSION\.[0-9]+\.\LOGS' | sort -rV | tail -n +$1 | head -n 1 | xargs -I {} find {} -type f -name 'printer.*' | xargs zcat"
  fi
}
