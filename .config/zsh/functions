# refresh tmux-provided env (SSH_AUTH_SOCK / DISPLAY) before each command.
# Registered via zsh's core add-zsh-hook (previously shadowed the preexec
# mechanism and ran `tmux` in shells that don't have it). Skipped entirely
# outside a tmux session or when tmux isn't installed.
_zsh_tmux_refresh_env() {
  (( $+commands[tmux] )) || return 0
  [[ -z $TMUX ]] && return 0
  local name val
  for name in SSH_AUTH_SOCK DISPLAY; do
    val=$(tmux show-env -v "$name" 2> /dev/null)
    [[ -n $val ]] && export "$name=$val"
  done
}
autoload -Uz add-zsh-hook
add-zsh-hook preexec _zsh_tmux_refresh_env

